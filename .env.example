# expense_world_engine — copy to .env and fill in.
# .env is gitignored and must never be committed.
#
# Local profile (current — see deploy/local/README.md): point everything at
# this machine. app/config.py refuses non-local SUPABASE_DB_URL hosts at
# startup; a cloud deployment must also set EXPENSE_ALLOW_REMOTE_DB=1
# (see deploy/cloud/README.md).

SUPABASE_DB_URL=postgresql://<role>@127.0.0.1:5432/expense_world

# SUPABASE_URL and SUPABASE_JWT_SECRET were removed 2026-08-03 along with the
# JWT auth branch. Auth is PAT-only; there is no secret to configure. Do not
# reintroduce a placeholder secret here — the committed value `local-unused`
# was a live auth bypass for as long as it existed (audit 2.1).

# Direct connection, no pgBouncer. Raise to ~50 only behind a transaction-mode
# pooler — see the pool-sizing comment in app/config.py.
DB_POOL_MAX_SIZE=20
